<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="739.0" prefWidth="1282.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.chainboutique.tanjum.returnExchangeController">
   <children>
      <VBox alignment="CENTER" layoutX="381.0" layoutY="33.0" prefHeight="67.0" prefWidth="544.0">
         <children>
            <Label fx:id="returnTitleLabel" text="Return/Exchange">
               <font>
                  <Font size="27.0" />
               </font>
            </Label>
         </children>
      </VBox>
      <Label layoutX="82.0" layoutY="118.0" text="Invoice Information" underline="true">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label fx:id="invoiceIdLabel" layoutX="62.0" layoutY="178.0" text="Invoice ID" />
      <TextField fx:id="invoiceIdTextField" layoutX="151.0" layoutY="174.0" />
      <Label fx:id="customerIdLabel" layoutX="62.0" layoutY="235.0" text="Customer ID" />
      <TextField fx:id="customerIdTextField" layoutX="151.0" layoutY="231.0" />
      <Label fx:id="customerNameLabel" layoutX="45.0" layoutY="298.0" text="Customer Name" />
      <TextField fx:id="customerNameTextField" editable="false" layoutX="151.0" layoutY="294.0" />
      <Button fx:id="btnSearchInvoice" layoutX="134.0" layoutY="350.0" mnemonicParsing="false" onAction="#searchInvoiceOnAction" text="Search Invoice" />
      <TableView fx:id="purchasedItemTableView" layoutX="338.0" layoutY="174.0" prefHeight="405.0" prefWidth="517.0">
        <columns>
          <TableColumn fx:id="productIdCol" prefWidth="117.0" text="Product ID" />
          <TableColumn fx:id="productNameCol" prefWidth="176.0" text="Product Name" />
            <TableColumn fx:id="quantityCol" prefWidth="103.0" text="Quantity" />
            <TableColumn fx:id="unitPriceCol" prefWidth="120.0" text="Unit Price" />
        </columns>
      </TableView>
      <Label layoutX="614.0" layoutY="123.0" text="Purchased Items" underline="true">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label fx:id="returnQuantityLabel" layoutX="925.0" layoutY="191.0" text="Return Quantity" />
      <TextField fx:id="returnQuantityTextField" layoutX="1051.0" layoutY="187.0" />
      <Label layoutX="925.0" layoutY="248.0" text="Reason" />
      <TextArea fx:id="reasonTextArea" layoutX="1051.0" layoutY="244.0" prefHeight="200.0" prefWidth="200.0" />
      <Label fx:id="actionLabel" layoutX="925.0" layoutY="487.0" text="Action" />
      <ComboBox fx:id="actionComboBox" layoutX="1051.0" layoutY="483.0" prefWidth="150.0" promptText="Choose Action" />
      <Label layoutX="1082.0" layoutY="128.0" text="Return Details" underline="true">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label fx:id="statusLabel" layoutX="925.0" layoutY="560.0" text="Status" />
      <TextField fx:id="statusTextField" editable="false" layoutX="1051.0" layoutY="556.0" />
      <HBox alignment="CENTER" layoutX="179.0" layoutY="616.0" prefHeight="100.0" prefWidth="876.0" spacing="20.0">
         <children>
            <Button fx:id="btnProcessReturn" mnemonicParsing="false" onAction="#processReturnOnAction" prefHeight="25.0" prefWidth="193.0" text="Process Return" />
            <Button fx:id="btnClear" mnemonicParsing="false" onAction="#clearOnAction" prefHeight="25.0" prefWidth="150.0" text="Clear" />
            <Button fx:id="btnNext" mnemonicParsing="false" onAction="#nextOnAction" prefHeight="25.0" prefWidth="217.0" text="Daily Sales Summary" />
            <Button fx:id="btnBack" mnemonicParsing="false" onAction="#backOnAction" prefHeight="25.0" prefWidth="163.0" text="Back" />
         </children>
      </HBox>
   </children>
</AnchorPane>
