<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="531.0" prefWidth="1029.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.chainboutique.tanjum.controller.SearchCustomerController">
   <children>
      <VBox alignment="CENTER" layoutX="302.0" layoutY="14.0" prefHeight="47.0" prefWidth="389.0">
         <children>
            <Label text="Search Customer" textAlignment="CENTER">
               <font>
                  <Font size="26.0" />
               </font>
            </Label>
         </children>
      </VBox>
      <Label fx:id="customerIdLabel" layoutX="29.0" layoutY="78.0" text="Customer ID" />
      <TextField fx:id="enterCustomerIdTextField" layoutX="113.0" layoutY="74.0" promptText="Enter Customer ID" />
      <Label fx:id="customerNameLabel" layoutX="19.0" layoutY="116.0" text="Customer Name" />
      <TextField fx:id="enterCustomerNameTextField" layoutX="113.0" layoutY="112.0" promptText="Enter Customer Name" />
      <Button fx:id="searchButton" layoutX="29.0" layoutY="165.0" mnemonicParsing="false" onAction="#searchOnAction" prefHeight="25.0" prefWidth="117.0" text="Search" />
      <Button fx:id="clearButton" layoutX="159.0" layoutY="165.0" mnemonicParsing="false" onAction="#clearOnAction" prefHeight="25.0" prefWidth="101.0" text="Clear" />
      <TableView fx:id="searchCustomerTableView" layoutX="279.0" layoutY="74.0" prefHeight="306.0" prefWidth="476.0">
        <columns>
          <TableColumn fx:id="customerIdCol" prefWidth="113.0" text="Customer ID" />
          <TableColumn fx:id="nameCol" prefWidth="114.0" text="Name" />
            <TableColumn fx:id="phoneNumberCol" prefWidth="121.0" text="Phone Number" />
            <TableColumn fx:id="emailCol" prefWidth="127.0" text="Email" />
        </columns>
      </TableView>
      <VBox alignment="CENTER" layoutX="768.0" layoutY="74.0" prefHeight="306.0" prefWidth="246.0" spacing="20.0">
         <children>
            <Label fx:id="customerdeatilsLabel" alignment="CENTER" text="Customer Details" underline="true" />
            <TextArea fx:id="customerDetailsTextArea" editable="false" prefHeight="200.0" prefWidth="200.0" />
         </children>
      </VBox>
      <HBox alignment="CENTER" layoutX="279.0" layoutY="406.0" prefHeight="100.0" prefWidth="476.0" spacing="20.0">
         <children>
            <Button fx:id="selectButton" mnemonicParsing="false" onAction="#selectCustomerOnAction" prefHeight="25.0" prefWidth="128.0" text="Select Customer" />
            <Button fx:id="backButton" mnemonicParsing="false" onAction="#backOnAction" prefHeight="25.0" prefWidth="103.0" text="Back" />
            <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#logoutOnAction" prefHeight="25.0" prefWidth="104.0" text="Logout" />
         </children>
      </HBox>
   </children>
</AnchorPane>
