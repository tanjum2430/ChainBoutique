<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="740.0" prefWidth="1421.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.chainboutique.tanjum.controller.SearchProductController">
   <children>
      <VBox alignment="CENTER" layoutX="417.0" layoutY="29.0" prefHeight="103.0" prefWidth="574.0">
         <children>
            <Label fx:id="searchProductLabel" text="Search Product">
               <font>
                  <Font size="27.0" />
               </font>
            </Label>
         </children>
      </VBox>
      <Label fx:id="productNameLabel" layoutX="50.0" layoutY="212.0" text="Product Name" />
      <Label layoutX="127.0" layoutY="159.0" text="Search Panel" underline="true">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <TextField fx:id="productNameTextField" layoutX="167.0" layoutY="208.0" promptText="Enter Product Name" />
      <ComboBox fx:id="searchCategoryComboBox" layoutX="66.0" layoutY="261.0" prefHeight="25.0" prefWidth="206.0" promptText="Category" />
      <Button fx:id="btnSearch" layoutX="100.0" layoutY="326.0" mnemonicParsing="false" onAction="#searchOnAction" prefHeight="25.0" prefWidth="128.0" text="Search" />
      <Button fx:id="btnRefresh" layoutX="119.0" layoutY="377.0" mnemonicParsing="false" onAction="#refreshOnAction" prefHeight="25.0" prefWidth="96.0" text="Refresh" />
      <TableView fx:id="searchProductsTableView" layoutX="352.0" layoutY="212.0" prefHeight="349.0" prefWidth="704.0">
        <columns>
          <TableColumn fx:id="productIdCol" prefWidth="121.0" text="Product ID" />
          <TableColumn fx:id="productNameCol" prefWidth="122.0" text="Product Name" />
            <TableColumn fx:id="categoryCol" prefWidth="122.0" text="Category" />
            <TableColumn fx:id="sizeCol" prefWidth="124.0" text="Size" />
            <TableColumn fx:id="priceCol" prefWidth="108.0" text="Price" />
            <TableColumn fx:id="stockCol" prefWidth="106.0" text="Stock" />
        </columns>
      </TableView>
      <Label layoutX="663.0" layoutY="159.0" text="Products" underline="true">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <VBox alignment="CENTER" layoutX="1088.0" layoutY="159.0" prefHeight="385.0" prefWidth="277.0" spacing="10.0">
         <children>
            <Label fx:id="productDetailsLabel" text="Product Details" />
            <TextArea editable="false" prefHeight="200.0" prefWidth="200.0" />
            <Label fx:id="quantityLabel" text="Quantity" />
            <TextField fx:id="quantityTextField" />
            <Button fx:id="btnAddToCart" mnemonicParsing="false" onAction="#addToCartButton" text="Add To Cart" />
         </children>
      </VBox>
      <HBox alignment="CENTER" layoutX="352.0" layoutY="588.0" prefHeight="100.0" prefWidth="704.0" spacing="30.0">
         <children>
            <Button fx:id="btnBack" mnemonicParsing="false" onAction="#backOnAction" prefHeight="25.0" prefWidth="162.0" text="Back" />
            <Button fx:id="btnCustomerDashboard" mnemonicParsing="false" onAction="#dashboardOnAction" prefHeight="25.0" prefWidth="250.0" text="Customer Dashboard" />
            <Button fx:id="btnCart" mnemonicParsing="false" onAction="#viewCartOnAction" prefHeight="25.0" prefWidth="146.0" text="View Cart" />
         </children>
      </HBox>
   </children>
</AnchorPane>
