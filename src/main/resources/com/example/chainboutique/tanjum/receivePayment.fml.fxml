<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="494.0" prefWidth="1060.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.chainboutique.tanjum.controller.ReceivePaymentController">
   <children>
      <VBox alignment="CENTER" layoutX="363.0" layoutY="14.0" prefHeight="66.0" prefWidth="382.0">
         <children>
            <Label fx:id="receivePaymentLabel" text="Receive Payment">
               <font>
                  <Font size="26.0" />
               </font>
            </Label>
         </children>
      </VBox>
      <Label fx:id="billIDLabel" layoutX="27.0" layoutY="131.0" text="Bill ID" />
      <TextField fx:id="billIDTextField" editable="false" layoutX="146.0" layoutY="127.0" />
      <Label fx:id="customerNameLabel" layoutX="27.0" layoutY="168.0" text="Customer Name" />
      <TextField fx:id="customerNameTextField" editable="false" layoutX="146.0" layoutY="164.0" />
      <Label fx:id="finalAmountLabel" layoutX="27.0" layoutY="208.0" text="Final Amount" />
      <TextField fx:id="finalAmountTextField" editable="false" layoutX="146.0" layoutY="204.0" />
      <Label layoutX="114.0" layoutY="80.0" text="Bill Information" underline="true">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label layoutX="378.0" layoutY="131.0" />
      <ComboBox fx:id="paymentMethodComboBox" layoutX="441.0" layoutY="127.0" prefHeight="25.0" prefWidth="204.0" promptText="Payment Method" />
      <Label fx:id="paidAmountLabel" layoutX="441.0" layoutY="168.0" prefHeight="17.0" prefWidth="79.0" text="Paid Amount" />
      <TextField fx:id="paidAmountTextField" layoutX="528.0" layoutY="164.0" prefHeight="25.0" prefWidth="149.0" />
      <Label fx:id="transactionIdLabel" layoutX="441.0" layoutY="200.0" text="Transaction ID" />
      <TextField fx:id="transactionIdTextField" layoutX="530.0" layoutY="196.0" />
      <Label fx:id="paymentStatusLabel" layoutX="441.0" layoutY="238.0" text="Payment Status" />
      <TextField fx:id="paymentStatusTextField" editable="false" layoutX="530.0" layoutY="234.0" />
      <TextArea fx:id="paymentDeatilsTextArea" editable="false" layoutX="753.0" layoutY="100.0" prefHeight="268.0" prefWidth="254.0" promptText="Payment Deatils" />
      <HBox alignment="CENTER" layoutX="116.0" layoutY="298.0" prefHeight="100.0" prefWidth="494.0" spacing="20.0">
         <children>
            <Button fx:id="btnVerify" mnemonicParsing="false" onAction="#verifyPaymentOnAction" text="Verify Payment" />
            <Button fx:id="btnReceive" mnemonicParsing="false" onAction="#receivePaymentOnAction" text="Receive Payment" />
            <Button fx:id="btnInvoice" mnemonicParsing="false" onAction="#generateInvoiceOnAction" text="Generate Invoice" />
            <Button fx:id="btnBack" mnemonicParsing="false" onAction="#backOnAction" prefHeight="25.0" prefWidth="60.0" text="Back" />
         </children>
      </HBox>
      <Label fx:id="paymentDetailsLabel" layoutX="490.0" layoutY="80.0" text="Payment Details" underline="true">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
