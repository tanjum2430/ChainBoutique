<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="433.0" prefWidth="727.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.chainboutique.tanjum.controller.CashierDashboardController">
   <children>
      <VBox alignment="CENTER" layoutX="97.0" layoutY="14.0" prefHeight="83.0" prefWidth="534.0">
         <children>
            <Label text="Cashier Dashboard">
               <font>
                  <Font size="26.0" />
               </font>
            </Label>
         </children>
      </VBox>
      <Button fx:id="btnSearchCustomer" layoutX="124.0" layoutY="115.0" mnemonicParsing="false" onAction="#searchCustomerOnAction" prefHeight="25.0" prefWidth="186.0" text="Search Customer" />
      <Button fx:id="btnCreateSalesBill" layoutX="441.0" layoutY="115.0" mnemonicParsing="false" onAction="#createSalesBillOnAction" prefHeight="25.0" prefWidth="160.0" text="Create Sales Bill" />
      <Button fx:id="btnApplyDiscount" layoutX="124.0" layoutY="194.0" mnemonicParsing="false" onAction="#applyDiscountOnAction" prefHeight="25.0" prefWidth="186.0" text="Apply Discount" />
      <Button fx:id="btnReceivePayment" layoutX="441.0" layoutY="194.0" mnemonicParsing="false" onAction="#receivePaymentOnAction" prefHeight="25.0" prefWidth="160.0" text="Receive Payment" />
      <Button fx:id="btnGenerateInvoice" layoutX="124.0" layoutY="279.0" mnemonicParsing="false" onAction="#generateInvoiceOnAction" prefHeight="25.0" prefWidth="186.0" text="Generate Invoice" />
      <Button fx:id="btnReturnExchange" layoutX="441.0" layoutY="279.0" mnemonicParsing="false" onAction="#returnExchangeOnAction" prefHeight="25.0" prefWidth="160.0" text="Return/Exchange" />
      <Button fx:id="btnDailySalesSummary" layoutX="125.0" layoutY="363.0" mnemonicParsing="false" onAction="#dailySalesSummaryOnAction" prefHeight="25.0" prefWidth="186.0" text="Daily Sales Summary" />
      <Button fx:id="btnLogout" layoutX="444.0" layoutY="363.0" mnemonicParsing="false" onAction="#logoutOnAction" prefHeight="25.0" prefWidth="160.0" text="Logout" />
   </children>
</AnchorPane>
