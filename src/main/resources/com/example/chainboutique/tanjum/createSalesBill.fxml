<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="566.0" prefWidth="1538.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.chainboutique.tanjum.controller.CreateSalesBillController">
   <children>
      <VBox alignment="CENTER" layoutX="623.0" layoutY="23.0" prefHeight="67.0" prefWidth="455.0">
         <children>
            <Label fx:id="createSalesBillLabel" text="Create Sales Bill">
               <font>
                  <Font size="25.0" />
               </font>
            </Label>
         </children>
      </VBox>
      <Label fx:id="customerIdLabel" layoutX="24.0" layoutY="111.0" prefHeight="17.0" prefWidth="114.0" text="Customer ID" />
      <TextField fx:id="customerIdTextField" layoutX="171.0" layoutY="107.0" />
      <Label fx:id="customerNameLabel" layoutX="23.0" layoutY="145.0" prefHeight="17.0" prefWidth="114.0" text="Custpomer Name" />
      <TextField fx:id="customerNameTextField" layoutX="170.0" layoutY="141.0" />
      <Label fx:id="phoneLabel" layoutX="23.0" layoutY="179.0" prefHeight="17.0" prefWidth="114.0" text="Phone Number" />
      <TextField fx:id="phoneTextField" layoutX="170.0" layoutY="175.0" />
      <TableView fx:id="createSalesBillTableView" layoutX="347.0" layoutY="107.0" prefHeight="305.0" prefWidth="455.0">
        <columns>
          <TableColumn fx:id="productIdCol" prefWidth="106.0" text="Product ID" />
          <TableColumn fx:id="productNameCol" prefWidth="128.0" text="Product Name" />
            <TableColumn fx:id="sizeCol" prefWidth="63.0" text="Size" />
            <TableColumn fx:id="priceCol" prefWidth="79.0" text="Price" />
            <TableColumn fx:id="stockCol" prefWidth="78.0" text="Stock" />
        </columns>
      </TableView>
      <VBox alignment="TOP_CENTER" layoutX="812.0" layoutY="107.0" prefHeight="170.0" prefWidth="197.0" spacing="20.0">
         <children>
            <Label fx:id="quantityLabel" text="Quantity" />
            <TextField fx:id="quantityTextField" />
            <Button fx:id="handleAddItemButton" mnemonicParsing="false" onAction="#addItemOnAction" prefHeight="25.0" prefWidth="106.0" text="Add Item" />
         </children>
      </VBox>
      <TableView fx:id="cartItemTableView" layoutX="1028.0" layoutY="107.0" prefHeight="305.0" prefWidth="485.0">
        <columns>
          <TableColumn fx:id="productCol" prefWidth="166.0" text="Product" />
          <TableColumn fx:id="quantityCol" prefWidth="85.0" text="Quantity" />
            <TableColumn fx:id="unitPriceCol" prefWidth="114.0" text="Unit Price" />
            <TableColumn fx:id="subtotalCol" prefWidth="120.0" text="Subtotal" />
        </columns>
      </TableView>
      <Label fx:id="totalAmountLabel" layoutX="1028.0" layoutY="450.0" prefHeight="17.0" prefWidth="106.0" text="Total Amount" textAlignment="CENTER" />
      <TextField fx:id="totalAmountTextField" editable="false" layoutX="1169.0" layoutY="446.0" />
      <HBox alignment="CENTER" layoutX="233.0" layoutY="446.0" prefHeight="100.0" prefWidth="645.0" spacing="30.0">
         <children>
            <Button fx:id="btnCalculate" mnemonicParsing="false" onAction="#calculateTotalOnAction" prefHeight="25.0" prefWidth="176.0" text="Calculate Total" />
            <Button fx:id="btnGenerateBill" mnemonicParsing="false" onAction="#generateBillOnAction" prefHeight="25.0" prefWidth="140.0" text="Generate Bill" />
            <Button fx:id="btnNext" mnemonicParsing="false" onAction="#nextOnAction" prefHeight="25.0" prefWidth="80.0" text="Next" />
            <Button fx:id="btnBack" mnemonicParsing="false" onAction="#backOnAction" prefHeight="25.0" prefWidth="81.0" text="Back" />
         </children>
      </HBox>
   </children>
</AnchorPane>
