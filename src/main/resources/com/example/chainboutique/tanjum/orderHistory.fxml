<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="472.0" prefWidth="789.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.chainboutique.tanjum.controller.OrderHistoryController">
   <children>
      <VBox alignment="CENTER" layoutX="209.0" layoutY="23.0" prefHeight="59.0" prefWidth="422.0">
         <children>
            <Label fx:id="orderHistoryLabel" text="Order History">
               <font>
                  <Font size="26.0" />
               </font>
            </Label>
         </children>
      </VBox>
      <TableView fx:id="orderHistoryTableView" layoutX="72.0" layoutY="98.0" prefHeight="241.0" prefWidth="452.0">
        <columns>
          <TableColumn fx:id="orderIdCol" prefWidth="121.0" text="Order ID" />
          <TableColumn fx:id="orderDateCol" prefWidth="102.0" text="Order Date" />
            <TableColumn fx:id="totalAmountCol" prefWidth="98.0" text="Total Amount" />
            <TableColumn fx:id="statusCol" prefWidth="130.0" text="Status" />
        </columns>
      </TableView>
      <VBox alignment="CENTER" layoutX="538.0" layoutY="73.0" prefHeight="215.0" prefWidth="232.0" spacing="10.0">
         <children>
            <Label fx:id="orderDetailsLabel" text="Order Details" />
            <TextArea fx:id="orderDetailsTextArea" editable="false" prefHeight="69.0" prefWidth="203.0" />
            <Label fx:id="deliveryAddressLabel" text="Delivery Address" />
            <TextArea fx:id="deliveryAddressTextArea" editable="false" prefHeight="69.0" prefWidth="203.0" />
         </children>
      </VBox>
      <HBox alignment="CENTER" layoutX="72.0" layoutY="335.0" prefHeight="100.0" prefWidth="452.0" spacing="20.0">
         <children>
            <Button fx:id="btnViewDetails" mnemonicParsing="false" onAction="#handleViewDetailsButton" prefHeight="25.0" prefWidth="164.0" text="View Details" />
            <Button fx:id="btnCancelOrder" mnemonicParsing="false" onAction="#handleCancelOrderButton" prefHeight="25.0" prefWidth="136.0" text="Cancel Order" />
            <Button fx:id="btnBack" mnemonicParsing="false" onAction="#handleBackButton" prefHeight="25.0" prefWidth="55.0" text="Back" />
         </children>
      </HBox>
   </children>
</AnchorPane>
