<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.chainboutique.tanjum.controller.CashierLoginController">
   <children>
      <Label layoutX="218.0" layoutY="31.0" text="Cashier Login">
         <font>
            <Font name="System Bold" size="26.0" />
         </font>
      </Label>
      <Label fx:id="cashierIDLabel" layoutX="38.0" layoutY="102.0" prefHeight="17.0" prefWidth="78.0" text="Cashier ID" />
      <TextField fx:id="cashierIDTextField" layoutX="161.0" layoutY="98.0" prefHeight="25.0" prefWidth="188.0" promptText="Enter Customer ID" />
      <PasswordField fx:id="pfPassword" layoutX="161.0" layoutY="144.0" prefHeight="25.0" prefWidth="188.0" promptText="Enter Your Password" />
      <Label fx:id="passwordLabel" layoutX="38.0" layoutY="148.0" prefHeight="17.0" prefWidth="78.0" text="Password" />
      <Label fx:id="messageLabel" layoutX="38.0" layoutY="192.0" prefHeight="17.0" prefWidth="78.0" text="Message" />
      <Label fx:id="writeMessageLabel" layoutX="161.0" layoutY="192.0" prefHeight="17.0" prefWidth="188.0" style="-fx-background-color: grey;" text="Write Here" />
      <HBox alignment="CENTER" layoutX="60.0" layoutY="237.0" prefHeight="100.0" prefWidth="429.0" spacing="30.0">
         <children>
            <Button fx:id="handleLoginButton" mnemonicParsing="false" onAction="#handleLoginButton" prefHeight="25.0" prefWidth="124.0" text="Login" />
            <Button mnemonicParsing="false" onAction="#handleClearButton" prefHeight="25.0" prefWidth="57.0" text="Clear" />
            <Button mnemonicParsing="false" onAction="#handleBackButton" prefHeight="25.0" prefWidth="52.0" text="Back" />
            <Button mnemonicParsing="false" onAction="#handleExitButton" prefHeight="25.0" prefWidth="45.0" text="Exit" />
         </children>
      </HBox>
   </children>
</AnchorPane>
