<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="537.0" prefWidth="859.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.chainboutique.tanjum.controller.CartController">
   <children>
      <VBox alignment="CENTER" layoutX="182.0" layoutY="24.0" prefHeight="41.0" prefWidth="381.0">
         <children>
            <Label fx:id="myShoppingCartLabel" prefHeight="36.0" prefWidth="207.0" text="My Shopping Cart">
               <font>
                  <Font size="25.0" />
               </font>
            </Label>
         </children>
      </VBox>
      <TableView fx:id="myShoppingCartTableView" layoutX="42.0" layoutY="82.0" prefHeight="290.0" prefWidth="468.0">
        <columns>
          <TableColumn fx:id="productIdCol" prefWidth="75.0" text="Product ID" />
          <TableColumn fx:id="productNameCol" prefWidth="89.0" text="Product Name" />
            <TableColumn fx:id="sizeCol" prefWidth="61.0" text="Size" />
            <TableColumn fx:id="quantityCol" prefWidth="75.0" text="Quantity" />
            <TableColumn fx:id="unitPriceCol" prefWidth="75.0" text="Unit Price" />
            <TableColumn fx:id="subtotalCol" prefWidth="92.0" text="Subtotal" />
        </columns>
      </TableView>
      <VBox alignment="CENTER" layoutX="538.0" layoutY="82.0" prefHeight="290.0" prefWidth="200.0" spacing="10.0">
         <children>
            <Label fx:id="cartSummaryLabel" text="Cart Summary">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
            <Label fx:id="totalAmountLabel" text="Total Amount" />
            <TextField fx:id="totalAmountTextField" />
            <Label fx:id="discountLabel" text="Discount" />
            <TextField fx:id="DiscountCodeTextField" promptText="Discount Code" />
            <Button mnemonicParsing="false" onAction="#handleApplyDiscountButton" text="Apply Discount" />
         </children>
      </VBox>
      <HBox alignment="CENTER" layoutX="42.0" layoutY="383.0" prefHeight="100.0" prefWidth="710.0" spacing="20.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleRemoveItemButton" text="Remove Item" />
            <Button mnemonicParsing="false" onAction="#handleClearCartButton" prefHeight="25.0" prefWidth="86.0" text="Clear Cart" />
            <Button mnemonicParsing="false" onAction="#handleCheckoutButton" prefHeight="25.0" prefWidth="168.0" text="Checkout" />
            <Button mnemonicParsing="false" onAction="#handleContinueShoppingButton" prefHeight="25.0" prefWidth="224.0" text="Continue Shopping" />
         </children>
      </HBox>
   </children>
</AnchorPane>
