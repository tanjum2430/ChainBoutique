<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="534.0" prefWidth="608.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.chainboutique.adib.DepartmentController">
   <children>
      <Label layoutX="88.0" layoutY="71.0" text="Department Id" />
      <TextField fx:id="departmentIdField" layoutX="185.0" layoutY="67.0" />
      <TextField fx:id="departmentNameField" layoutX="185.0" layoutY="121.0" />
      <Label layoutX="76.0" layoutY="125.0" text="Department Name" />
      <Label layoutX="411.0" layoutY="29.0" prefHeight="17.0" prefWidth="94.0" text="description" />
      <TextArea fx:id="descriptionArea" layoutX="411.0" layoutY="46.0" prefHeight="200.0" prefWidth="200.0" />
      <Button fx:id="addDepartmentButton" layoutX="70.0" layoutY="251.0" mnemonicParsing="false" onAction="#addDepartment" text="Add Department" />
      <Button fx:id="clearButton" layoutX="203.0" layoutY="251.0" mnemonicParsing="false" onAction="#clearFields" text="Clear" />
      <Label layoutX="49.0" layoutY="304.0" text="Search Department" />
      <TextField fx:id="searchField" layoutX="161.0" layoutY="300.0" />
      <Button fx:id="searchButton" layoutX="359.0" layoutY="300.0" mnemonicParsing="false" onAction="#searchDepartment" text="searchButton" />
      <Button fx:id="refreshButton" layoutX="492.0" layoutY="300.0" mnemonicParsing="false" onAction="#refreshTable" text="refreshButton" />
      <TableView fx:id="departmentTable" layoutX="1.0" layoutY="334.0" prefHeight="200.0" prefWidth="632.0">
        <columns>
          <TableColumn fx:id="departmentIdColumn" prefWidth="207.0" text="departmentId" />
          <TableColumn fx:id="departmentNameColumn" prefWidth="251.0" text="department Name" />
            <TableColumn fx:id="descriptionColumn" prefWidth="173.0" text="description" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
