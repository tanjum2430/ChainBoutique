      <Button fx:id="refreshButton" layoutX="340.0" layoutY="372.0" mnemonicParsing="false" onAction="#refreshtable" prefHeight="25.0" prefWidth="132.0" text="refresh" />
      <TableView layoutX="4.0" layoutY="412.0" prefHeight="200.0" prefWidth="830.0">
        <columns>
          <TableColumn fx:id="inventoryIdColumn" prefWidth="261.0" text="Inventory ID" />
          <TableColumn fx:id="totalStockValueColumn" prefWidth="297.0" text="Total Stock Value" />
            <TableColumn fx:id="lastUpdatedColumn" prefWidth="271.0" text="Last Updated" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
