<?import javafx.scene.layout.AnchorPane?>


<AnchorPane prefHeight="612.0" prefWidth="833.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.chainboutique.adib.Controller.InventoryController">
   <children>
      <Label layoutX="21.0" layoutY="44.0" prefHeight="17.0" prefWidth="94.0" text="Inventory ID" />
      <TextField fx:id="inventoryIdField" layoutX="98.0" layoutY="41.0" prefHeight="25.0" prefWidth="174.0" />
      <Label layoutX="4.0" layoutY="76.0" prefHeight="17.0" prefWidth="94.0" text="Total Stock Value" />
      <TextField fx:id="totalStockValueField" layoutX="98.0" layoutY="73.0" prefHeight="25.0" prefWidth="174.0" />
      <Label layoutX="14.0" layoutY="107.0" prefHeight="17.0" prefWidth="72.0" text="Last Updated" />
      <Label layoutX="185.0" layoutY="327.0" text="Search Inventory ID" />
      <DatePicker fx:id="lastUpdatedPicker" layoutX="98.0" layoutY="103.0" />
      <Button fx:id="addInventoryButton" layoutX="64.0" layoutY="150.0" mnemonicParsing="false" onAction="#addInventory" text="Add Inventory" />
      <Button fx:id="clearButton" layoutX="160.0" layoutY="150.0" mnemonicParsing="false" onAction="#clearFields" text="Clear" />
      <TextField fx:id="searchField" layoutX="301.0" layoutY="323.0" />
