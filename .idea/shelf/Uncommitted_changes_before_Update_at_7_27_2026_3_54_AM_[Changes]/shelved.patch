+    private String phoneNo; // Unique
+    private String password, address;
+    private String employeeID; // Primary Key (Unique)
+
+    public String getName() {
+        return name;
+    }
+
+    public void setName(String name) {
+        this.name = name;
+    }
+
+    @Override
